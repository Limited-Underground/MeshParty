{
  "name": "meshparty-abuse-reports",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "reports.example.com", "custom_domain": true }],
  "vars": { "RETENTION_DAYS": "30" },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "meshparty-abuse-reports",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": { "crons": ["13 3 * * *"] }
}
